{
  "name": "Skinwise · Python 3.11",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "if [ -f packages.txt ]; then sudo apt-get update && sudo xargs -a packages.txt apt-get install -y; fi && pip install --user -r requirements.txt",
  "postAttachCommand": {
    "server": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection true"
  },
  "portsAttributes": {
    "8501": {
      "label": "Skinwise",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501]
}
